#nginx
DOMAIN_NAME=ramarti2.42.fr

#database vars
MYSQL_DATABASE=wordpress_db
MYSQL_USER=wpdb_user
MYSQL_PASSWORD_FILE=/run/secrets/db_password # docker takes secret file on host and mounts it to this path in the container!
MYSQL_ROOT_PASSWORD_FILE=/run/secrets/db_root_password

#wordpress stuff
WP_USER=ramarti2u
WP_ADMIN=ramarti2
WP_ADMIN_EMAIL=ra@ramarti2.42.fr # REMOVE LATER
WP_USER_EMAIL=ru@ramarti2.42.fr
WP_USER_PASSWORD_FILE=/run/secrets/wp_user_password
WP_ADMIN_PASSWORD_FILE=/run/secrets/wp_admin_password
WP_DB_PASSWORD_FILE=/run/secrets/
WP_DB_USER=${MYSQL_USER}
WP_DB_NAME=${MYSQL_DATABASE}
WP_DB_HOST=mariadb
WP_TABLE_PREFIX=wp_
WP_TITLE="Inception website"

